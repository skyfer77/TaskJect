@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changePasswordModalLabel">@Localizer["ChangePassword"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm">
                    <div class="row gy-3">
                        <ul class="ms-2 text-muted fs-14 mt-0 mb-0 p-3 pb-0" id="password-requirements">
                            <li id="length" class="invalid">@Localizer["AtLeastCharactersLong"]</li>
                            <li id="digit" class="invalid">@Localizer["MustContainLeastDigit"]</li>
                            <li id="uppercase" class="invalid">@Localizer["MustContainLeastUppercaseLetter"]</li>
                            <li id="special" class="invalid">@Localizer["MustContainLeastSpecialCharacter"]</li>
                        </ul>
                        <div>
                            <label for="currentPassword" class="form-label">@Localizer["CurrentPassword"]</label>
                            <input type="password" class="form-control" name="CurrentPassword" id="currentPassword" required>
                        </div>
                        <div>
                            <label for="newPassword" class="form-label">@Localizer["NewPassword"]</label>
                            <input type="password" class="form-control" id="newPassword" required>
                        </div>
                        <div>
                            <label for="confirmPassword" class="form-label">@Localizer["ConfirmPassword"]</label>
                            <input type="password" class="form-control" name="NewPassword" id="confirmPassword" required>
                            <div id="passwordMatchError" class="text-danger mt-1 d-none">
                                @Localizer["PasswordDontMatch"]
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
                <button type="submit" form="changePasswordForm" class="btn btn-primary" >@Localizer["Save"]</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/check-pass-requriments.js"></script>

<style>
    .valid { color: green; }
    .invalid { color: red; }

    #confirmed,
    #warning {
        z-index: 1100 !important;
    }

        #confirmed .modal-backdrop,
        #warning .modal-backdrop {
            z-index: 1099 !important;
        }
</style>