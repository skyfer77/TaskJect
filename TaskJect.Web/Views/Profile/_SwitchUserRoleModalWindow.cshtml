@using TaskJect.Web.Resources
@using Domain.Database
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@model IEnumerable<ApplicationUserLiteDto>
<div class="modal fade" id="switch-delete-user-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-alert1 alert-danger">
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="text-center px-5 pb-0">
                <svg class="custom-alert-icon svg-danger" xmlns="http://www.w3.org/2000/svg" height="1.5rem" viewBox="0 0 24 24" width="1.5rem" fill="#000000">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <path d="M15.73 3H8.27L3 8.27v7.46L8.27 21h7.46L21 15.73V8.27L15.73 3zM12 17.3c-.72 0-1.3-.58-1.3-1.3 0-.72.58-1.3 1.3-1.3.72 0 1.3.58 1.3 1.3 0 .72-.58 1.3-1.3 1.3zm1-4.3h-2V7h2v6z" />
                </svg>
                <h5 class="break-word-normal">@Localizer["SwitchUserNewRoleTeamLeadHeader"]?</h5>
                <div class="text-start mb-2">
                    <select class="form-control" name="UserId" id="select-user" data-type="select-one">
                        <option value="">@Localizer["SelectUser"]</option>
                        @foreach (var user in Model)
                        {
                            <option value="@user.Id"> @(user.Name) @(user.Surname) </option>
                        }
                    </select>
                </div>
                <div>
                    <button type="button" class="btn btn-light m-1" data-bs-dismiss="modal">
                        @Localizer["Cancel"]
                    </button>
                    <button type="button" class="btn btn-danger m-1" onclick="confirmSwitchAndDelete()">
                        @Localizer["Delete"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
