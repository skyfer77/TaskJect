@using Domain.Database
@model IEnumerable<LightOrganizationFiles>
@functions {
    public string FormatFileSize(long sizeInBytes)
    {
        if (sizeInBytes < 1024)
            return $"{sizeInBytes} bytes";
        else if (sizeInBytes < 1024 * 1024)
            return $"{(sizeInBytes / 1024.0):N1} KB";
        else
            return $"{(sizeInBytes / 1024.0 / 1024.0):N1} MB";
    }
}

@foreach (var file in Model)
{
    <li class="list-group-item" data-file-id="@file.Id">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="flex-fill" style="max-width: 68%;">
                <span class="d-block fw-semibold text-truncate d-inline-block" style="max-width: 100%;" title="@file.FileName">@file.FileName</span>
                <span class="d-block text-muted fs-12 fw-normal">@FormatFileSize(file.Size)</span>
            </div>
            <div class="btn-list">
                <a class="btn btn-sm btn-icon btn-info-light btn-wave" href="@Url.Action("DownloadFile", "Project", new { id = file.Id })">
                    <i class="bi bi-download"></i>
                </a>
                <button class="btn btn-sm btn-icon btn-danger-light btn-wave" data-file-id="@file.Id" data-file-name="@file.FileName"
                        data-bs-toggle="modal" data-bs-target="#delete-file-modal">
                    <i class="ri-delete-bin-line"></i>
                </button>
            </div>
        </div>
    </li>
}
