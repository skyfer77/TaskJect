@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@model AnalysisProjectModel
@{
    ViewBag.Title = "Projects analytics";
}
<!-- Page Header -->
<div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
    <h1 class="page-title fw-semibold fs-18 mb-0">@Localizer["ProjectsAnalytics"]</h1>
    <div class="ms-md-1 ms-0">
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Project" asp-action="Index">@Localizer["Projects"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["ProjectsAnalytics"]</li>
            </ol>
        </nav>
    </div>
</div>
<!-- Page Header Close -->

<!-- End::page-header -->

<!-- Start::row-1 -->
<div class="row">
    <div class="col-xxl-6">
        <div class="row">
            <div class="col-xxl-6">
                <div class="col-sm-12">
                    <div class="card custom-card">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <p class="mb-2">@Localizer["CompletedTasks"]</p>
                                <h4 class="mb-0 fw-semibold mb-2">@Model.Project.TaskCompleted</h4>
                                <span class="badge bg-success-transparent">1.5% <i class="ti ti-trending-up"></i></span><span class="text-muted fs-11 ms-1">@Localizer["ThisMonthLowerCase"]</span>
                            </div>
                            <div>
                                <span class="avatar avatar-md bg-primary p-2">
                                    <i class="ti ti-file-check fs-20 op-7"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="card custom-card">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <p class="mb-2">@Localizer["TotalTasks"]</p>
                                <h4 class="mb-0 fw-semibold mb-2">@Model.Project.TaskTotal</h4>
                                <span class="badge bg-success-transparent">0.67% <i class="ti ti-trending-up"></i></span><span class="text-muted fs-11 ms-1">@Localizer["ThisMonthLowerCase"]</span>
                            </div>
                            <div>
                                <span class="avatar avatar-md bg-success p-2">
                                    <i class="ti ti-album fs-20 op-7"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-6">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="card custom-card">
                            <div class="card-header justify-content-between">
                                <div class="card-title">
                                    @Localizer["Team"] @Model.Team.Name: members
                                </div>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled team-members-card mb-0">
                                    @foreach(var item in Model.Users){
                                        <li>
                                            <a href="javascript:void(0)">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-top">
                                                        <span class="avatar avatar-sm lh-1">
                                                            <img src="~/images/faces/2.jpg" alt="">
                                                        </span>
                                                        <div class="ms-3 lh-1">
                                                            <span class="fw-semibold">@item.Name @item.Surname</span>
                                                            <span class="d-block fs-11 text-muted mt-2">@Localizer["UIDeveloper"]</span>
                                                        </div>
                                                    </div>
                                                    @*<div id="users"></div>*@
                                                </div>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div> 
                </div>
            </div>
            <div class="col-xxl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            @Localizer["ProjectAnalysis"]
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="projectAnalysis"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xxl-3">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">
                    @Localizer["DailyTasks"]
                </div>
                <div class="d-flex flex-wrap">
                    @*<div class="dropdown my-1">*@
                        <a href="javascript:void(0);" class="btn btn-primary btn-sm btn-wave waves-effect waves-light" aria-expanded="false">
                            @Localizer["TaskBoard"]
                        </a>
                    @*</div>*@
                </div>
            </div>
            <div class="card-body">
                <ul class="list-unstyled daily-task-card">
                    @foreach (var task in Model.Tasks)
                    {
                        <li>
                            <div class="card border border-primary border-opacity-25 shadow-none custom-card mb-0">
                                <div class="card-body">
                                    <p class="fs-14 fw-semibold mb-2 lh-1 d-flex align-items-center gap-2 justify-content-between">
                                        @task.Title
                                        <a aria-label="anchor" href="javascript:void(0);"><i class="bi bi-plus-square float-end text-primary fs-18"></i></a>
                                    </p>
                                    <div class="d-flex flex-wrap gap-2 mb-4">
                                        <span class="badge bg-primary-transparent">@Localizer["Framework"]</span>
                                        <span class="badge bg-secondary-transparent">@Localizer["Angular"]</span>
                                        <span class="badge bg-info-transparent">@Localizer["Php"]</span>
                                    </div>
                                    <div class="avatar-list-stacked">
                                        <span class="avatar avatar-sm avatar-rounded">
                                            <img src="~/images/faces/2.jpg" alt="img">
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-xxl-3">
        <div class="row">
            <div class="col-xxl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            @Localizer["ProjectDescription"]
                        </div>
                        <div class="d-flex flex-wrap">
                            <a asp-controller="Project" asp-action="Overview" asp-route-id="@Model.Project.ID" class="btn btn-primary btn-sm btn-wave waves-effect waves-light" aria-expanded="false">
                                @Localizer["Overview"]
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="text-muted task-description" id="desc">
                            @Html.Raw( System.Net.WebUtility.HtmlDecode(@Model.Project.Description))
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</div>
<!--End::row-1 -->

<!-- Start::row-3 -->
