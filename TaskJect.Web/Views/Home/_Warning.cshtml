@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
<div class="modal fade" id="warning" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-alert1 alert-warning">
            <button type="button" class="btn-close  ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="text-center px-5 pb-0">
                <svg class="custom-alert-icon svg-warning" xmlns="http://www.w3.org/2000/svg" height="1.5rem" viewBox="0 0 24 24" width="1.5rem" fill="#000000"><path d="M0 0h24v24H0z" fill="none"/><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                <h5>@Localizer["Warning"]</h5>
                <h6 id="responseTextWar" class="" style="margin-block-end: 2.5rem;color: var(--text-muted);"></h6>
                <div>
                    <button type="button" class="btn btn-warning m-1" data-bs-dismiss="modal" aria-label="Close">@Localizer["Close"]</button>
                </div>
            </div>
        </div>
    </div>
</div>
