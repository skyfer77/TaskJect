@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@model TaskJect.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<p class="h5 fw-semibold mb-2">@Localizer["ResetPassword"]</p>
<form asp-controller="Account" asp-action="ResetPassword" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Email" asp-for="Email" />
    <input type="hidden" name="Code" asp-for="Code" />
    @* <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /> *@
    <div class="row gy-3">
        <ul class="ms-3 text-muted fs-14 mt-2" id="password-requirements">
            <li id="length" class="invalid">@Localizer["AtLeastCharactersLong"]</li>
            <li id="digit" class="invalid">@Localizer["MustContainLeastDigit"]</li>
            <li id="uppercase" class="invalid">@Localizer["MustContainLeastUppercaseLetter"]</li>
            <li id="special" class="invalid">@Localizer["MustContainLeastSpecialCharacter"]</li>
        </ul>
        <div class="col-xl-12 mt-0"><partial name="_ValidationSummary" /></div>
        <div class="col-xl-12 mb-3">
            <label asp-for="Password" class="form-label text-default d-block">@Localizer["Password"]</label>
            <input type="password" class="form-control form-control-lg" placeholder="@Localizer["Password"]" asp-for="Password">
        </div>
        <div class="col-xl-12 mb-3">
            <label asp-for="ConfirmPassword" class="form-label text-default d-block">@Localizer["ConfirmPassword"]</label>
            <input type="password" class="form-control form-control-lg" placeholder="@Localizer["ConfirmPassword"]" asp-for="ConfirmPassword" autocomplete="off">
        </div>
        <div class="col-xl-12 d-grid mt-3">
            <button type="submit" class="form-control btn btn-primary">@Localizer["ResetPassword"]</button>
        </div>
    </div>
</form>