@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@model TaskJect.Web.Models.LogoutViewModel
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<p class="h5 fw-semibold mb-2">@Localizer["YouNowLoggedOut"]</p>

<p class="mb-4 text-muted op-7 fw-normal">@Localizer["ClickLoginReturnPageLogin"].</p>
<div class="row gy-3">
    <div class="col-xl-12 d-grid mt-2">
        <a class="btn btn-lg btn-primary" href="@Url.Action("Login","Account")">@Localizer["LogIn"]</a>
    </div>
</div>