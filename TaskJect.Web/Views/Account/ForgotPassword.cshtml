@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@model TaskJect.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<p class="h5 fw-semibold mb-2">@Localizer["ForgotPassword"]</p>
<div class="col-xl-12 mt-0"><partial name="_ValidationSummary" /></div>
<form asp-controller="Account" asp-action="ForgotPassword" method="post">
    @* <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" /> *@
    <div class="row gy-3">
        <div class="col-xl-12 mb-3">
            <label asp-for="Email" class="form-label text-default">@Localizer["Email"]</label>
            <input type="text" class="form-control form-control-lg" id="email" name="email" placeholder="@Localizer["Email"]" asp-for="Email" autofocus>
        </div>
        <div class="col-xl-12 d-grid mt-3">
            <button type="submit" class="form-control btn btn-primary">@Localizer["SendResetLink"]</button>
        </div>
    </div>     
</form>
                    