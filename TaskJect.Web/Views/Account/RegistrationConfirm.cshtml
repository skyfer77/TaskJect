@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@model TaskJect.Web.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "Registration Confirm";
}

<p class="h5 fw-semibold mb-2">@Localizer["RegistrationConfirmTitle"]</p>
<p class="mb-4 text-muted op-7 fw-normal">@Localizer["RegistrationConfirmMessage"].</p>
<div class="row gy-3">
    <div class="col-xl-12 d-grid mt-2">
        <a href="@Url.Action("Login", "Account")" class="btn btn-lg btn-primary">@Localizer["GoToLogin"]</a>
    </div>
</div>