@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = "Forgot Password Confirmation";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<p class="h5 fw-semibold mb-2">@Localizer["ForgotPasswordConfirmation"]</p>
<p class="mb-4 text-muted op-7 fw-normal">@Localizer["WeveSentEmailInstructionsResetPassword"].</p>
<div class="row gy-3">
    <div class="col-xl-12 d-grid mt-2">
        <a href="@Url.Action("Login", "Account")" class="btn btn-lg btn-primary">@Localizer["GoToLogin"]</a>
    </div>
</div>
                        
                    