<div class="text-center my-3 authentication-barrier">
    <span>@Localizer["OrUpperCase"]</span>
</div> *@
<p class="mb-1 text-muted fs-14">@Localizer["Password"]</p>
<ul class="ms-3 text-muted fs-14" id="password-requirements">
    <li id="length" class="invalid">@Localizer["AtLeastCharactersLong"]</li>
    <li id="digit" class="invalid">@Localizer["MustContainLeastDigit"]</li>
    <li id="uppercase" class="invalid">@Localizer["MustContainLeastUppercaseLetter"]</li>
    <li id="special" class="invalid">@Localizer["MustContainLeastSpecialCharacter"]</li>
</ul>
<div class="col-xl-12 mt-0"><partial name="_ValidationSummary" /></div>
<form asp-route="Login">
    @* <input type="hidden" asp-for="ReturnUrl" /> *@
    <div class="row gy-3">
        <div class="col-xl-12">
            <label asp-for="OrganizationName" class="form-label text-default">@Localizer["OrganizationName"]</label>
            <input type="text" class="form-control form-control-lg" placeholder="@Localizer["OrganizationName"]" asp-for="OrganizationName" autofocus>
        </div>
        <div class="col-xl-12">
            <label asp-for="Email" class="form-label text-default">@Localizer["Email"]</label>
            <input type="email" class="form-control form-control-lg" placeholder="@Localizer["Email"]" asp-for="Email" autofocus>
        </div>
        <div class="col-xl-12">
            <label asp-for="FirstName" class="form-label text-default">@Localizer["FirstName"]</label>
            <input type="text" class="form-control form-control-lg" placeholder="@Localizer["FirstName"]" asp-for="FirstName" autofocus>
        </div>
        <div class="col-xl-12">
            <label asp-for="LastName" class="form-label text-default">@Localizer["LastName"]</label>
            <input type="text" class="form-control form-control-lg" placeholder="@Localizer["LastName"]" asp-for="LastName" autofocus>
        </div>
        <div class="col-xl-12">
            <label asp-for="Password" class="form-label text-default">@Localizer["Password"]</label>
            <input type="password" class="form-control form-control-lg" placeholder="@Localizer["Password"]" asp-for="Password" autocomplete="off">
        </div>
        <div class="col-xl-12">
            <label asp-for="ConfirmPassword" class="form-label text-default">@Localizer["ConfirmPassword"]</label>
            <input type="password" class="form-control form-control-lg" placeholder="@Localizer["ConfirmPassword"]" asp-for="ConfirmPassword" autocomplete="off">
        </div>
        <div class="col-xl-12 d-grid mt-3">
            <button class="btn btn-lg btn-primary" name="button" value="Register">@Localizer["CreateAccount"]</button>
        </div>
    </div>
</form>
<div class="text-start">
    <p class="fs-12 text-muted mt-2">@Localizer["AlreadyHaveAccount"] <a href="@Url.Action("Login", "Account")" class="text-primary">@Localizer["LogIn"]</a></p>
</div>