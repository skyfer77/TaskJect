@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
@{
    ViewBag.Title = "404";
    Layout = null;
}
<html lang="en" dir="ltr" data-nav-layout="vertical" data-vertical-style="overlay" data-theme-mode="light" data-header-styles="light" data-menu-styles="light" data-toggled="close">

<head>

    <!-- Meta Data -->
    <meta charset="UTF-8">
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title> Error </title>

    <!-- Favicon -->
    <link rel="icon" href="~/images/brand-logos/favicon.ico" type="image/x-icon">

    <!-- Main Theme Js -->
    <script src="~/js/authentication-main.js"></script>

    <!-- Bootstrap Css -->
    <link id="style" href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <!-- Style Css -->
    <link href="~/css/styles.min.css" rel="stylesheet">

    <!-- Icons Css -->
    <link href="~/css/icons.min.css" rel="stylesheet">


</head>

<body>
    <div class="page error-bg" id="particles-js">
        <!-- Start::error-page -->
        <div class="error-page">
            <div class="container">
                <div class="text-center p-5 my-auto">
                    <div class="row align-items-center justify-content-center h-100">
                        <div class="col-xl-7">
                            <p class="fs-18 fw-semibold mb-3">404 - @Localizer["PageNotFound"]</p>
                            <div class="row justify-content-center mb-5">
                                <div class="col-xl-6">
                                    <p class="mb-0 op-7">@Localizer["OopsBetterCheckThatURL"].</p>
                                </div>
                            </div>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="ri-arrow-left-line align-middle me-1 d-inline-block"></i>@Localizer["BACKTOHOME"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Particles JS -->
    <script src="~/lib/particles.js/particles.js"></script>

    <!-- Error JS -->
    <script src="~/js/error.js"></script>

</body>

</html>