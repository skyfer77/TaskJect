@using TaskJect.Web.Resources
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer
<div class="text-center p-5 my-auto">
    <div class="row align-items-center justify-content-center">
        <div class="col-xl-7">
            <div class="card custom-card p-5">
                <p class="error-text mb-sm-0 mb-2">403</p>
                <p class="fs-18 fw-semibold mb-3">@Localizer["NotAccessThisPage"]</p>
                <div class="row justify-content-center mb-5">
                    <div class="col-xl-6">
                        <p class="mb-0 op-7">@Localizer["SorryYouDoNotHaveSufficientPermissions"]</p>
                    </div>
                </div>
                <a asp-controller="Profile" asp-action="Index" class="btn btn-primary">
                    <i class="ri-arrow-left-line align-middle me-1 d-inline-block"></i>@Localizer["ReturnToProfileUpperCase"]
                </a>
            </div>
        </div>
    </div>
</div>
