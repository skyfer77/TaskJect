{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "Default": "Information", 
      "Microsoft": "Warning", 
      "Worker": "Warning",
      "Function": "Information",
      "System": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Connection": "Warning"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    }
  }
}
